# Reference systemd unit for the CachyOS deploy box. Hand-managed; see
# irc-serve-stable.service for why CI never writes this file (#532).
[Unit]
Description=irc-serve federated node B (irc.b :6669)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=irc-serve
ExecStart=/opt/irc-serve/irc-serve-fed-b --name irc.b --secret-file /etc/irc-serve/fed-secret --peer irc.a,127.0.0.1,6668 6669
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
