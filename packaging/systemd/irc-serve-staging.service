# Reference systemd unit for the CachyOS deploy box. Hand-managed; see
# irc-serve-stable.service for why CI never writes this file (#532).
[Unit]
Description=irc-serve staging (:6668)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=nobody
ExecStart=/opt/irc-serve/irc-serve-staging --name irc.test 6668
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
